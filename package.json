{
  "private": true,
  "name": "task-tracker-test-automation",
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @workspace/backend --filter @workspace/frontend dev",
    "test": "pnpm --filter @workspace/backend --filter @workspace/frontend test",
    "test:watch": "pnpm --parallel --filter @workspace/backend --filter @workspace/frontend test:watch",
    "test:coverage": "pnpm --filter @workspace/backend --filter @workspace/frontend test:coverage",
    "test:frontend": "pnpm --filter @workspace/frontend test",
    "test:backend": "pnpm --filter @workspace/backend test",
    "test:frontend:watch": "pnpm --filter @workspace/frontend test:watch",
    "test:backend:watch": "pnpm --filter @workspace/backend test:watch",
    "test:frontend:coverage": "pnpm --filter @workspace/frontend test:coverage",
    "test:backend:coverage": "pnpm --filter @workspace/backend test:coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.18.0"
}
